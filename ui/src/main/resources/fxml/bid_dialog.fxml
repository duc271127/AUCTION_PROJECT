<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.BidDialogController"
      prefWidth="420"
      prefHeight="640"
      spacing="0"
      styleClass="modal-card">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="modal-header">
        <Label text="Set maximum bid" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="×"
                onAction="#handleClose"
                focusTraversable="false"
                styleClass="modal-close-button"/>
    </HBox>

    <VBox spacing="18">
        <padding>
            <Insets top="22" right="24" bottom="24" left="24"/>
        </padding>

        <VBox spacing="6">
            <Label text="LOT" styleClass="balance-label"/>
            <Label fx:id="lotTitleLabel"
                   text="Auction title"
                   wrapText="true"
                   styleClass="item-title"/>
        </VBox>

        <VBox spacing="6" styleClass="soft-panel">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <Label text="CURRENT BID" styleClass="balance-label"/>
            <Label fx:id="currentBidLabel"
                   text="€ 0"
                   styleClass="balance-value"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Your maximum bid" styleClass="field-label"/>

            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="€"
                       minWidth="48"
                       alignment="CENTER"
                       style="-fx-background-color:#f2f2f2;-fx-border-color:#e5e7eb;-fx-border-radius:7 0 0 7;-fx-background-radius:7 0 0 7;-fx-font-size:16px;-fx-font-weight:800;"/>
                <TextField fx:id="bidInputField"
                           promptText="1155"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-radius:0 7 7 0;-fx-border-radius:0 7 7 0;"/>
            </HBox>

            <Label fx:id="minimumBidLabel"
                   text="Minimum bid: € 0"
                   styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="info-box">
            <Label text="ℹ How automatic bidding works"
                   styleClass="field-label"/>
            <Label text="We'll automatically bid on your behalf up to your maximum bid, in small increments, against other bidders."
                   wrapText="true"
                   styleClass="muted-text"/>
        </VBox>

        <CheckBox fx:id="confirmCheckBox"
                  text="I agree to the terms and conditions and confirm that I want to set this maximum bid."
                  wrapText="true"
                  styleClass="muted-text"/>

        <Label fx:id="errorLabel"
               text=""
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="error-label"/>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="12">
            <Button text="Cancel"
                    onAction="#handleClose"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    styleClass="secondary-button"/>

            <Button fx:id="submitBidButton"
                    text="Set max bid"
                    onAction="#handleSubmitBid"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    disable="true"
                    styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
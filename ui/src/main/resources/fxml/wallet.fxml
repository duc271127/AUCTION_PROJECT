<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.WalletController"
            prefWidth="1200" prefHeight="820"
            styleClass="wallet-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="wallet-topbar">
            <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
            <VBox spacing="4.0">
                <Label text="Wallet" styleClass="page-title"/>
                <Label fx:id="walletOwnerLabel" text="User" styleClass="page-subtitle"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Back" styleClass="secondary-button" onAction="#handleBack"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0">
            <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
            <VBox spacing="16.0" prefWidth="320.0" styleClass="wallet-panel">
                <Label text="Current Balance" styleClass="wallet-panel-title"/>
                <Label fx:id="walletBalanceLabel" text="$0" styleClass="wallet-balance"/>
                <Label text="Amount" styleClass="field-label"/>
                <TextField fx:id="amountField" promptText="Enter amount"/>
                <HBox spacing="10.0">
                    <Button text="Deposit" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="primary-button" onAction="#handleDeposit"/>
                    <Button text="Withdraw" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="secondary-button" onAction="#handleWithdraw"/>
                </HBox>
                <Label fx:id="walletMessageLabel" text="" wrapText="true" styleClass="wallet-message"/>
            </VBox>
            <VBox spacing="14.0" HBox.hgrow="ALWAYS" styleClass="wallet-panel">
                <Label text="Transaction History" styleClass="wallet-panel-title"/>
                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="120.0"/>
                        <TableColumn fx:id="amountColumn" text="Amount" prefWidth="140.0"/>
                        <TableColumn fx:id="balanceColumn" text="Balance After" prefWidth="160.0"/>
                        <TableColumn fx:id="createdColumn" text="Created" prefWidth="260.0"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.HomeController"
            prefWidth="1400"
            prefHeight="900"
            styleClass="home-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="market-top-nav">
                    <padding>
                        <Insets top="14" right="24" bottom="14" left="24"/>
                    </padding>

                    <Label text="Auctions" styleClass="market-brand"/>

                    <MenuButton text="Categories"
                                focusTraversable="false"
                                styleClass="market-category-menu"
                                onAction="#handleGoToCategory">
                        <items>
                            <MenuItem text="Art" onAction="#handleGoToArt"/>
                            <MenuItem text="Jewellery" onAction="#handleGoToJewellery"/>
                            <MenuItem text="Watches" onAction="#handleGoToWatches"/>
                            <MenuItem text="Fashion" onAction="#handleGoToFashion"/>
                        </items>
                    </MenuButton>

                    <Button text="For you"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToShowroom"/>

                    <Button text="Trending"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToTrending"/>

                    <TextField fx:id="searchField"
                               onAction="#handleSearch"
                               promptText="Search jewelry, watches, art ..."
                               focusTraversable="false"
                               styleClass="market-search"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Login / Register"
                            styleClass="secondary-button"
                            onAction="#handleGoToAuth"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll">
                    <content>
                        <StackPane styleClass="page-shell">
                            <children>
                                <VBox spacing="42.0" styleClass="page-content home-page">
                                    <padding>
                                        <Insets top="28" right="24" bottom="42" left="24"/>
                                    </padding>

                                    <HBox spacing="40.0" styleClass="home-hero">
                                        <VBox spacing="18.0" styleClass="home-hero-copy" HBox.hgrow="ALWAYS">
                                            <Label text="Special objects,&#10;selected by experts"
                                                   styleClass="home-hero-title"/>

                                            <Label text="Discover and bid on exceptional collectibles, rare items, and unique treasures curated by our team of expert auctioneers."
                                                   styleClass="home-hero-subtitle"
                                                   wrapText="true"/>

                                            <HBox spacing="16.0">
                                                <Button text="Start Bidding"
                                                        styleClass="primary-button"
                                                        onAction="#handleGoToShowroom"/>

                                                <Button text="Learn More"
                                                        styleClass="secondary-button"
                                                        onAction="#handleGoToShowroom"/>
                                            </HBox>
                                        </VBox>

                                        <StackPane styleClass="home-hero-image-wrap">
                                            <ImageView fx:id="heroImageView"
                                                       fitWidth="540"
                                                       fitHeight="385"
                                                       preserveRatio="false"
                                                       styleClass="home-hero-image"/>
                                        </StackPane>
                                    </HBox>

                                    <VBox spacing="18.0">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Auction" styleClass="home-section-title"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Button text="View all"
                                                    styleClass="home-view-all"
                                                    onAction="#handleGoToShowroom"/>
                                        </HBox>

                                        <TilePane fx:id="auctionGrid"
                                                  hgap="16.0"
                                                  vgap="16.0"
                                                  prefColumns="4"
                                                  prefTileWidth="256.0"
                                                  styleClass="home-card-grid"/>
                                    </VBox>

                                    <VBox spacing="18.0">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="For you" styleClass="home-section-title"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Button text="View all"
                                                    styleClass="home-view-all"
                                                    onAction="#handleGoToShowroom"/>
                                        </HBox>

                                        <TilePane fx:id="forYouGrid"
                                                  hgap="16.0"
                                                  vgap="16.0"
                                                  prefColumns="4"
                                                  prefTileWidth="256.0"
                                                  styleClass="home-card-grid"/>
                                    </VBox>

                                    <VBox spacing="18.0">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Trending" styleClass="home-section-title"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Button text="View all"
                                                    styleClass="home-view-all"
                                                    onAction="#handleGoToTrending"/>
                                        </HBox>

                                        <TilePane fx:id="trendingGrid"
                                                  hgap="16.0"
                                                  vgap="16.0"
                                                  prefColumns="4"
                                                  prefTileWidth="256.0"
                                                  styleClass="home-card-grid"/>
                                    </VBox>
                                </VBox>
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>

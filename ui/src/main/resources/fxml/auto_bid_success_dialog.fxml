<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.AutoBidSuccessDialogController"
      prefWidth="460"
      prefHeight="520"
      spacing="0"
      styleClass="modal-card">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="modal-header">
        <Label text="⚡ Auto-Bid" styleClass="modal-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="×"
                onAction="#handleClose"
                focusTraversable="false"
                styleClass="modal-close-button"/>
    </HBox>

    <VBox alignment="CENTER" spacing="18" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="60" right="28" bottom="60" left="28"/>
        </padding>

        <StackPane styleClass="success-circle">
            <Label text="✓"
                   style="-fx-text-fill:#111111;-fx-font-size:40px;-fx-font-weight:800;"/>
        </StackPane>

        <Label text="Auto-Bid Activated!"
               style="-fx-text-fill:#222222;-fx-font-size:26px;-fx-font-weight:800;"/>

        <Label fx:id="successMessageLabel"
               text="We'll automatically bid on your behalf."
               wrapText="true"
               styleClass="muted-text"/>

        <HBox alignment="CENTER" spacing="8"
              style="-fx-background-color:#eef4ff;-fx-background-radius:999;-fx-padding:10 18;">
            <Label text="⚡" style="-fx-font-size:16px;-fx-font-weight:800;"/>
            <Label text="Auto-Bid is running"
                   style="-fx-text-fill:#0047ff;-fx-font-size:16px;-fx-font-weight:800;"/>
        </HBox>

        <Label text="Closing..." styleClass="muted-text"/>
    </VBox>
</VBox>
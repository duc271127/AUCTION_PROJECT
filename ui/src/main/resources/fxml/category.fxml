<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.CategoryController"
            prefWidth="1400"
            prefHeight="900"
            styleClass="category-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="market-top-nav">
                    <padding>
                        <Insets top="12" right="32" bottom="12" left="32"/>
                    </padding>

                    <Label text="Auctions" styleClass="market-brand"/>

                    <MenuButton text="Categories"
                                focusTraversable="false"
                                styleClass="market-category-menu">

                        <items>
                            <MenuItem text="Art"
                                      onAction="#handleGoToArt"/>

                            <MenuItem text="Jewellery"
                                      onAction="#handleGoToJewellery"/>

                            <MenuItem text="Watches"
                                      onAction="#handleGoToWatches"/>

                            <MenuItem text="Fashion"
                                      onAction="#handleGoToFashion"/>
                        </items>
                    </MenuButton>

                    <Button text="For you"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToForYou"/>

                    <Button text="Trending"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToTrending"/>

                    <TextField promptText="Search jewelry, watches, art ..."
                               focusTraversable="false"
                               styleClass="market-search"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Wallet"
                            focusTraversable="false"
                            styleClass="market-wallet-button"/>

                    <Button text="&#9825;"
                            focusTraversable="false"
                            styleClass="market-icon-button"
                            onAction="#handleGoToForYou"/>

                    <Label text="User"
                           styleClass="market-user-icon"/>

                    <Label fx:id="usernameLabel"
                           text="Username"
                           styleClass="market-username"/>

                    <Button text="Logout"
                            focusTraversable="false"
                            styleClass="secondary-button"
                            onAction="#handleLogout"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="category-scroll">

                    <content>
                        <VBox spacing="26.0" styleClass="category-page">

                            <VBox spacing="28.0">

                                <!-- Category hero -->
                                <HBox spacing="28.0"
                                      alignment="CENTER_LEFT"
                                      styleClass="category-hero">

                                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="categoryTitleLabel"
                                               text="Art"
                                               styleClass="category-title"/>

                                        <Label fx:id="categoryDescriptionLabel"
                                               text="Explore exceptional contemporary and classic artworks. From paintings and sculptures to digital installations, find unique pieces curated by leading art experts."
                                               wrapText="true"
                                               styleClass="category-description"/>

                                        <HBox spacing="10.0">
                                            <Button text="Browse Auctions"
                                                    focusTraversable="false"
                                                    styleClass="primary-button"/>

                                            <Button text="Save Category"
                                                    focusTraversable="false"
                                                    styleClass="secondary-button"/>
                                        </HBox>
                                    </VBox>

                                    <Region prefWidth="420.0"
                                            prefHeight="18.0"
                                            styleClass="category-banner-placeholder"/>
                                </HBox>

                                <!-- Stats -->
                                <HBox spacing="14.0">
                                    <VBox spacing="5.0"
                                          styleClass="category-stat-card"
                                          HBox.hgrow="ALWAYS">
                                        <Label text="TOTAL AUCTIONS"
                                               styleClass="category-stat-label"/>
                                        <Label text="6"
                                               styleClass="category-stat-number"/>
                                    </VBox>

                                    <VBox spacing="5.0"
                                          styleClass="category-stat-card"
                                          HBox.hgrow="ALWAYS">
                                        <Label text="ENDING SOON"
                                               styleClass="category-stat-label"/>
                                        <Label text="12"
                                               styleClass="category-stat-number"/>
                                    </VBox>

                                    <VBox spacing="5.0"
                                          styleClass="category-stat-card"
                                          HBox.hgrow="ALWAYS">
                                        <Label text="ACTIVE BIDDERS"
                                               styleClass="category-stat-label"/>
                                        <Label text="342"
                                               styleClass="category-stat-number"/>
                                    </VBox>

                                    <VBox spacing="5.0"
                                          styleClass="category-stat-card"
                                          HBox.hgrow="ALWAYS">
                                        <Label text="AVG. PRICE"
                                               styleClass="category-stat-label"/>
                                        <Label text="€ 1,250"
                                               styleClass="category-stat-number"/>
                                    </VBox>
                                </HBox>

                                <!-- Auction grid -->
                                <FlowPane hgap="18.0"
                                          vgap="18.0"
                                          prefWrapLength="1200.0"
                                          styleClass="category-grid">

                                    <!-- Card 1 -->
                                    <VBox prefWidth="260.0"
                                          spacing="8.0"
                                          styleClass="category-card">

                                        <StackPane>
                                            <Region prefHeight="260.0"
                                                    styleClass="category-card-media"/>

                                            <Button text="&#9825;"
                                                    focusTraversable="false"
                                                    StackPane.alignment="TOP_RIGHT"
                                                    styleClass="category-heart-button"/>
                                        </StackPane>

                                        <Label text="SARAH MITCHELL"
                                               styleClass="category-seller"/>

                                        <Label text="Contemporary Abstract Painting"
                                               wrapText="true"
                                               styleClass="category-card-title"/>

                                        <Label text="Ending in 2 days"
                                               styleClass="category-ending"/>
                                    </VBox>

                                    <!-- Card 2 -->
                                    <VBox prefWidth="260.0"
                                          spacing="8.0"
                                          styleClass="category-card">

                                        <StackPane>
                                            <Region prefHeight="260.0"
                                                    styleClass="category-card-media"/>

                                            <Button text="&#9825;"
                                                    focusTraversable="false"
                                                    StackPane.alignment="TOP_RIGHT"
                                                    styleClass="category-heart-button"/>
                                        </StackPane>

                                        <Label text="MARCO ROSSI"
                                               styleClass="category-seller"/>

                                        <Label text="Impressionist Landscape Oil"
                                               wrapText="true"
                                               styleClass="category-card-title"/>

                                        <Label text="Ending in 5 days"
                                               styleClass="category-ending"/>
                                    </VBox>

                                    <!-- Card 3 -->
                                    <VBox prefWidth="260.0"
                                          spacing="8.0"
                                          styleClass="category-card">

                                        <StackPane>
                                            <Region prefHeight="260.0"
                                                    styleClass="category-card-media"/>

                                            <Button text="&#9825;"
                                                    focusTraversable="false"
                                                    StackPane.alignment="TOP_RIGHT"
                                                    styleClass="category-heart-button"/>
                                        </StackPane>

                                        <Label text="EMMA CHEN"
                                               styleClass="category-seller"/>

                                        <Label text="Modern Pop Art Collection"
                                               wrapText="true"
                                               styleClass="category-card-title"/>

                                        <Label text="Ending now!"
                                               styleClass="category-ending"/>
                                    </VBox>

                                    <!-- Card 4 -->
                                    <VBox prefWidth="260.0"
                                          spacing="8.0"
                                          styleClass="category-card">

                                        <StackPane>
                                            <Region prefHeight="260.0"
                                                    styleClass="category-card-media"/>

                                            <Button text="&#9825;"
                                                    focusTraversable="false"
                                                    StackPane.alignment="TOP_RIGHT"
                                                    styleClass="category-heart-button"/>
                                        </StackPane>

                                        <Label text="GIOVANNI MORETTI"
                                               styleClass="category-seller"/>

                                        <Label text="Surrealist Sculpture Piece"
                                               wrapText="true"
                                               styleClass="category-card-title"/>

                                        <Label text="New listing"
                                               styleClass="category-ending"/>
                                    </VBox>

                                    <!-- Card 5 -->
                                    <VBox prefWidth="260.0"
                                          spacing="8.0"
                                          styleClass="category-card">

                                        <StackPane>
                                            <Region prefHeight="260.0"
                                                    styleClass="category-card-media"/>

                                            <Button text="&#9825;"
                                                    focusTraversable="false"
                                                    StackPane.alignment="TOP_RIGHT"
                                                    styleClass="category-heart-button"/>
                                        </StackPane>

                                        <Label text="LISA ZHANG"
                                               styleClass="category-seller"/>

                                        <Label text="Mixed Media Installation"
                                               wrapText="true"
                                               styleClass="category-card-title"/>

                                        <Label text="Ending in 1 day"
                                               styleClass="category-ending"/>
                                    </VBox>

                                    <!-- Card 6 -->
                                    <VBox prefWidth="260.0"
                                          spacing="8.0"
                                          styleClass="category-card">

                                        <StackPane>
                                            <Region prefHeight="260.0"
                                                    styleClass="category-card-media"/>

                                            <Button text="&#9825;"
                                                    focusTraversable="false"
                                                    StackPane.alignment="TOP_RIGHT"
                                                    styleClass="category-heart-button"/>
                                        </StackPane>

                                        <Label text="ALEX TURNER"
                                               styleClass="category-seller"/>

                                        <Label text="Digital Art NFT Edition"
                                               wrapText="true"
                                               styleClass="category-card-title"/>

                                        <Label text="Ending in 3 days"
                                               styleClass="category-ending"/>
                                    </VBox>

                                </FlowPane>

                                <!-- Load more -->
                                <HBox alignment="CENTER">
                                    <Button text="Load More Art Auctions"
                                            focusTraversable="false"
                                            styleClass="category-load-button"/>
                                </HBox>

                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
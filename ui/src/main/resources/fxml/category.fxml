<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.CategoryController"
            prefWidth="1400"
            prefHeight="900"
            styleClass="category-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="market-top-nav">
                    <padding>
                        <Insets top="12" right="32" bottom="12" left="32"/>
                    </padding>

                    <Label text="Auctions" styleClass="market-brand"/>

                    <MenuButton text="Categories"
                                focusTraversable="false"
                                styleClass="market-category-menu">
                        <items>
                            <MenuItem text="Art" onAction="#handleGoToArt"/>
                            <MenuItem text="Jewellery" onAction="#handleGoToJewellery"/>
                            <MenuItem text="Watches" onAction="#handleGoToWatches"/>
                            <MenuItem text="Fashion" onAction="#handleGoToFashion"/>
                        </items>
                    </MenuButton>

                    <Button text="For you"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToForYou"/>

                    <Button text="Trending"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToTrending"/>

                    <TextField fx:id="searchField"
                               promptText="Search jewelry, watches, art ..."
                               focusTraversable="false"
                               styleClass="market-search"
                               onAction="#handleSearch"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Wallet"
                            focusTraversable="false"
                            styleClass="market-wallet-button"
                            onAction="#handleOpenWallet"/>

                    <Button text="&#9825;"
                            focusTraversable="false"
                            styleClass="market-icon-button"
                            onAction="#handleGoToForYou"/>

                    <Label text="User" styleClass="market-user-icon"/>

                    <Label fx:id="usernameLabel"
                           text="Username"
                           styleClass="market-username"/>

                    <Button text="Logout"
                            focusTraversable="false"
                            styleClass="secondary-button"
                            onAction="#handleLogout"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="category-scroll">

                    <content>
                        <StackPane styleClass="page-shell">
                            <children>
                        <VBox spacing="26.0" styleClass="category-page page-content">
                            <VBox spacing="28.0">
                                <HBox spacing="28.0"
                                      alignment="CENTER_LEFT"
                                      styleClass="category-hero">
                                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="categoryTitleLabel"
                                               text="Art"
                                               styleClass="category-title"/>

                                        <Label fx:id="categoryDescriptionLabel"
                                               text="Explore exceptional artworks and collectibles from active auctions."
                                               wrapText="true"
                                               styleClass="category-description"/>

                                        <HBox spacing="10.0">
                                            <Button text="Browse Auctions"
                                                    focusTraversable="false"
                                                    styleClass="primary-button"
                                                    onAction="#handleBrowseAuctions"/>

                                            <Button fx:id="saveCategoryButton"
                                                    text="Save Category"
                                                    focusTraversable="false"
                                                    styleClass="secondary-button"
                                                    onAction="#handleSaveCategory"/>
                                        </HBox>
                                    </VBox>

                                    <Region prefWidth="420.0"
                                            prefHeight="18.0"
                                            styleClass="category-banner-placeholder"/>
                                </HBox>

                                <HBox spacing="14.0">
                                    <VBox spacing="5.0" styleClass="category-stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="TOTAL AUCTIONS" styleClass="category-stat-label"/>
                                        <Label fx:id="totalAuctionsLabel" text="0" styleClass="category-stat-number"/>
                                    </VBox>

                                    <VBox spacing="5.0" styleClass="category-stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="ENDING SOON" styleClass="category-stat-label"/>
                                        <Label fx:id="endingSoonLabel" text="0" styleClass="category-stat-number"/>
                                    </VBox>

                                    <VBox spacing="5.0" styleClass="category-stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="ACTIVE BIDDERS" styleClass="category-stat-label"/>
                                        <Label fx:id="activeBiddersLabel" text="0" styleClass="category-stat-number"/>
                                    </VBox>

                                    <VBox spacing="5.0" styleClass="category-stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="AVG. PRICE" styleClass="category-stat-label"/>
                                        <Label fx:id="averagePriceLabel" text="USD 0" styleClass="category-stat-number"/>
                                    </VBox>
                                </HBox>

                                <TilePane fx:id="categoryGrid"
                                          hgap="18.0"
                                          vgap="18.0"
                                          prefColumns="3"
                                          prefTileWidth="300.0"
                                          styleClass="category-grid"/>

                                <HBox alignment="CENTER">
                                    <Button fx:id="loadMoreButton"
                                            text="Load More Auctions"
                                            focusTraversable="false"
                                            styleClass="category-load-button"
                                            onAction="#handleLoadMore"/>
                                </HBox>
                            </VBox>
                        </VBox>
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.ShowRoomController"
            prefWidth="1400" prefHeight="900"
            styleClass="showroom-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="market-top-nav">
                    <padding>
                        <Insets top="12" right="32" bottom="12" left="32"/>
                    </padding>

                    <Label text="Auctions" styleClass="market-brand"/>

                    <MenuButton text="Categories"
                                focusTraversable="false"
                                styleClass="market-category-menu">

                        <items>
                            <MenuItem text="Art"
                                      onAction="#handleGoToArt"/>

                            <MenuItem text="Jewellery"
                                      onAction="#handleGoToJewellery"/>

                            <MenuItem text="Watches"
                                      onAction="#handleGoToWatches"/>

                            <MenuItem text="Fashion"
                                      onAction="#handleGoToFashion"/>
                        </items>
                    </MenuButton>

                    <Button text="For you"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToForYou"/>

                    <Button text="Trending"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToTrending"/>

                    <TextField promptText="Search jewelry, watches, art ..."
                               focusTraversable="false"
                               styleClass="market-search"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Wallet"
                            focusTraversable="false"
                            styleClass="market-wallet-button"
                            onAction="#handleOpenWallet"/>

                    <Button fx:id="wishlistButton"
                            text="&#9825; 0"
                            focusTraversable="false"
                            styleClass="market-icon-button"
                            onAction="#handleGoToForYou"/>

                    <Label text="User"
                           styleClass="market-user-icon"/>

                    <Label fx:id="usernameLabel"
                           text="Username"
                           styleClass="market-username"/>

                    <Button text="Logout"
                            focusTraversable="false"
                            styleClass="secondary-button"
                            onAction="#handleLogout"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="for-you-scroll">
                    <content>
                        <VBox spacing="24.0" styleClass="for-you-page">
                            <padding>
                                <Insets top="32" right="36" bottom="32" left="36"/>
                            </padding>

                            <VBox spacing="8.0">
                                <Label text="&#9825; For You" styleClass="for-you-title"/>
                                <Label text="Personalized auctions based on your interests and bidding history"
                                       styleClass="page-subtitle"
                                       wrapText="true"/>
                            </VBox>

                            <VBox spacing="8.0">
                                <Label text="YOUR INTERESTS" styleClass="section-eyebrow"/>

                                <HBox spacing="8.0">
                                    <Label text="Jewelry" styleClass="interest-tag"/>
                                    <Label text="Watches" styleClass="interest-tag"/>
                                    <Label text="Antiques" styleClass="interest-tag"/>
                                    <Label text="Art" styleClass="interest-tag"/>
                                    <Label text="Collectibles" styleClass="interest-tag"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="16.0">
                                <VBox spacing="6.0" styleClass="for-you-stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Saved Auctions" styleClass="for-you-stat-label"/>
                                    <Label fx:id="savedAuctionsCountLabel" text="0" styleClass="for-you-stat-number"/>
                                </VBox>

                                <VBox spacing="6.0" styleClass="for-you-stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Active Bids" styleClass="for-you-stat-label"/>
                                    <Label text="5" styleClass="for-you-stat-number"/>
                                </VBox>

                                <VBox spacing="6.0" styleClass="for-you-stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Auto-Bids" styleClass="for-you-stat-label"/>
                                    <Label text="3" styleClass="for-you-stat-number"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="20.0">
                                <VBox spacing="8.0" styleClass="for-you-auction-card" HBox.hgrow="ALWAYS">
                                    <StackPane>
                                        <ImageView fx:id="item1ImageView"
                                                   fitWidth="320"
                                                   fitHeight="230"
                                                   preserveRatio="false"
                                                   styleClass="auction-card-image"/>
                                        <Button fx:id="item1FavoriteButton"
                                                text="&#9825;"
                                                StackPane.alignment="TOP_RIGHT"
                                                styleClass="favorite-floating-button"
                                                onAction="#handleToggleFavorite1"/>
                                    </StackPane>
                                    <Label fx:id="item1StatusLabel" text="ACTIVE" styleClass="auction-seller-label"/>
                                    <Label fx:id="item1NameLabel" text="Item Name" styleClass="auction-card-title"/>
                                    <Label fx:id="item1BidLabel" text="Current Bid" styleClass="auction-price-label"/>
                                    <Label fx:id="item1TimeLabel" text="Ending now" styleClass="auction-ending-label"/>
                                    <Button text="View Details"
                                            maxWidth="Infinity"
                                            styleClass="ghost-button"
                                            onAction="#handleViewDetails1"/>
                                </VBox>

                                <VBox spacing="8.0" styleClass="for-you-auction-card" HBox.hgrow="ALWAYS">
                                    <StackPane>
                                        <ImageView fx:id="item2ImageView"
                                                   fitWidth="320"
                                                   fitHeight="230"
                                                   preserveRatio="false"
                                                   styleClass="auction-card-image"/>
                                        <Button fx:id="item2FavoriteButton"
                                                text="&#9825;"
                                                StackPane.alignment="TOP_RIGHT"
                                                styleClass="favorite-floating-button"
                                                onAction="#handleToggleFavorite2"/>
                                    </StackPane>
                                    <Label fx:id="item2StatusLabel" text="ACTIVE" styleClass="auction-seller-label"/>
                                    <Label fx:id="item2NameLabel" text="Item Name" styleClass="auction-card-title"/>
                                    <Label fx:id="item2BidLabel" text="Current Bid" styleClass="auction-price-label"/>
                                    <Label fx:id="item2TimeLabel" text="Ending now" styleClass="auction-ending-label"/>
                                    <Button text="View Details"
                                            maxWidth="Infinity"
                                            styleClass="ghost-button"
                                            onAction="#handleViewDetails2"/>
                                </VBox>

                                <VBox spacing="8.0" styleClass="for-you-auction-card" HBox.hgrow="ALWAYS">
                                    <StackPane>
                                        <ImageView fx:id="item3ImageView"
                                                   fitWidth="320"
                                                   fitHeight="230"
                                                   preserveRatio="false"
                                                   styleClass="auction-card-image"/>
                                        <Button fx:id="item3FavoriteButton"
                                                text="&#9825;"
                                                StackPane.alignment="TOP_RIGHT"
                                                styleClass="favorite-floating-button"
                                                onAction="#handleToggleFavorite3"/>
                                    </StackPane>
                                    <Label fx:id="item3StatusLabel" text="ACTIVE" styleClass="auction-seller-label"/>
                                    <Label fx:id="item3NameLabel" text="Item Name" styleClass="auction-card-title"/>
                                    <Label fx:id="item3BidLabel" text="Current Bid" styleClass="auction-price-label"/>
                                    <Label fx:id="item3TimeLabel" text="Ending now" styleClass="auction-ending-label"/>
                                    <Button text="View Details"
                                            maxWidth="Infinity"
                                            styleClass="ghost-button"
                                            onAction="#handleViewDetails3"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.ShowRoomController"
            prefWidth="1400" prefHeight="900"
            styleClass="showroom-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="market-top-nav">
                    <padding>
                        <Insets top="18" right="36" bottom="18" left="36"/>
                    </padding>

                    <Label text="Auctions" styleClass="market-brand"/>

                    <Button text="Categories ▾"
                            focusTraversable="false"
                            styleClass="market-nav-link"/>

                    <Button text="For you"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToForYou"/>

                    <Button text="Trending"
                            focusTraversable="false"
                            styleClass="market-nav-link"/>

                    <TextField promptText="Tìm kiếm trang sức, đồ dùng ..."
                               styleClass="market-search"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="▣"
                            styleClass="market-icon-button"/>

                    <Button fx:id="wishlistButton"
                            text="♡"
                            styleClass="market-icon-button"
                            onAction="#handleOpenWishlist"/>

                    <Label text="♟"
                           styleClass="market-user-icon"/>

                    <Label fx:id="usernameLabel"
                           text="Username"
                           styleClass="market-username"/>
                </HBox>
            </top>

            <center>
                <VBox spacing="24.0">
                    <padding>
                        <Insets top="32" right="36" bottom="32" left="36"/>
                    </padding>

                    <VBox spacing="8.0">
                        <Label text="Live Showroom" styleClass="page-title"/>
                        <Label text="Discover active lots, monitor current bids, and move into detailed bidding rooms."
                               styleClass="page-subtitle"
                               wrapText="true"/>
                    </VBox>

                    <HBox spacing="14.0">
                        <TextField promptText="Search items (demo only)"
                                   HBox.hgrow="ALWAYS"/>
                        <ComboBox promptText="Filter status (demo only)"/>
                    </HBox>

                    <HBox spacing="20.0">
                        <VBox spacing="12.0" styleClass="item-card" HBox.hgrow="ALWAYS">
                            <ImageView fx:id="item1ImageView" fitWidth="280" fitHeight="180" preserveRatio="true"/>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label fx:id="item1NameLabel" text="Item Name" styleClass="item-title" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="item1FavoriteButton"
                                        text="♡"
                                        styleClass="favorite-button"
                                        onAction="#handleToggleFavorite1"/>
                            </HBox>
                            <Label fx:id="item1BidLabel" text="Current Bid" styleClass="item-meta"/>
                            <Label fx:id="item1TimeLabel" text="Time Left" styleClass="item-meta"/>
                            <Label fx:id="item1StatusLabel" text="LIVE" styleClass="item-status"/>
                            <Button text="View Details"
                                    maxWidth="Infinity"
                                    styleClass="primary-button"
                                    onAction="#handleViewDetails1"/>
                        </VBox>

                        <VBox spacing="12.0" styleClass="item-card" HBox.hgrow="ALWAYS">
                            <ImageView fx:id="item2ImageView" fitWidth="280" fitHeight="180" preserveRatio="true"/>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label fx:id="item2NameLabel" text="Item Name" styleClass="item-title" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="item2FavoriteButton"
                                        text="♡"
                                        styleClass="favorite-button"
                                        onAction="#handleToggleFavorite2"/>
                            </HBox>
                            <Label fx:id="item2BidLabel" text="Current Bid" styleClass="item-meta"/>
                            <Label fx:id="item2TimeLabel" text="Time Left" styleClass="item-meta"/>
                            <Label fx:id="item2StatusLabel" text="LIVE" styleClass="item-status"/>
                            <Button text="View Details"
                                    maxWidth="Infinity"
                                    styleClass="primary-button"
                                    onAction="#handleViewDetails2"/>
                        </VBox>

                        <VBox spacing="12.0" styleClass="item-card" HBox.hgrow="ALWAYS">
                            <ImageView fx:id="item3ImageView" fitWidth="280" fitHeight="180" preserveRatio="true"/>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label fx:id="item3NameLabel" text="Item Name" styleClass="item-title" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="item3FavoriteButton"
                                        text="♡"
                                        styleClass="favorite-button"
                                        onAction="#handleToggleFavorite3"/>
                            </HBox>
                            <Label fx:id="item3BidLabel" text="Current Bid" styleClass="item-meta"/>
                            <Label fx:id="item3TimeLabel" text="Time Left" styleClass="item-meta"/>
                            <Label fx:id="item3StatusLabel" text="LIVE" styleClass="item-status"/>
                            <Button text="View Details"
                                    maxWidth="Infinity"
                                    styleClass="primary-button"
                                    onAction="#handleViewDetails3"/>
                        </VBox>
                    </HBox>
                </VBox>
            </center>
        </BorderPane>

        <StackPane fx:id="wishlistOverlay"
                   visible="false"
                   managed="false"
                   styleClass="wishlist-overlay"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">
            <children>
                <VBox maxWidth="760.0"
                      prefWidth="760.0"
                      minHeight="260.0"
                      styleClass="wishlist-dialog">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="wishlist-header">
                        <Label fx:id="wishlistTitleLabel"
                               text="My Wishlist (0)"
                               styleClass="wishlist-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="X"
                                styleClass="wishlist-close-button"
                                onAction="#handleCloseWishlist"/>
                    </HBox>

                    <VBox fx:id="wishlistContentBox"
                          spacing="0.0"
                          styleClass="wishlist-content"/>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.WonAuctionsController"
            prefWidth="1400"
            prefHeight="900"
            styleClass="won-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="market-top-nav">
                    <padding>
                        <Insets top="12" right="32" bottom="12" left="32"/>
                    </padding>

                    <Label text="Auctions" styleClass="market-brand"/>

                    <MenuButton text="Categories"
                                focusTraversable="false"
                                styleClass="market-category-menu">
                        <items>
                            <MenuItem text="Art" onAction="#handleGoToArt"/>
                            <MenuItem text="Jewellery" onAction="#handleGoToJewellery"/>
                            <MenuItem text="Watches" onAction="#handleGoToWatches"/>
                            <MenuItem text="Fashion" onAction="#handleGoToFashion"/>
                        </items>
                    </MenuButton>

                    <Button text="For you"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToForYou"/>

                    <Button text="Trending"
                            focusTraversable="false"
                            styleClass="market-nav-link"
                            onAction="#handleGoToTrending"/>

                    <TextField fx:id="searchField"
                               onAction="#handleSearch"
                               promptText="Search jewelry, watches, art ..."
                               focusTraversable="false"
                               styleClass="market-search"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Wallet"
                            focusTraversable="false"
                            styleClass="market-wallet-button"
                            onAction="#handleOpenWallet"/>

                    <Button text="Wins"
                            focusTraversable="false"
                            styleClass="market-wallet-button"
                            onAction="#handleOpenWonAuctions"/>

                    <Button fx:id="wishlistButton"
                            text="&#9825; 0"
                            focusTraversable="false"
                            styleClass="market-icon-button"
                            onAction="#handleGoToForYou"/>

                    <Label text="User" styleClass="market-user-icon"/>

                    <Label fx:id="usernameLabel"
                           text="Username"
                           styleClass="market-username"/>

                    <Button text="Logout"
                            focusTraversable="false"
                            styleClass="market-logout-button"
                            onAction="#handleLogout"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="won-scroll">
                    <content>
                        <StackPane styleClass="page-shell">
                            <children>
                                <VBox spacing="24.0" styleClass="won-page page-content">
                                    <padding>
                                        <Insets top="28" right="24" bottom="36" left="24"/>
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="18.0">
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                            <Label text="Winner Center" styleClass="won-title"/>
                                            <Label text="Track every successful auction, review final prices, and keep your winning items in one place."
                                                   wrapText="true"
                                                   styleClass="page-subtitle"/>
                                        </VBox>

                                        <Button text="Refresh"
                                                focusTraversable="false"
                                                styleClass="secondary-button"
                                                onAction="#handleRefresh"/>
                                    </HBox>

                                    <HBox spacing="16.0">
                                        <VBox spacing="6.0" styleClass="won-stat-card" HBox.hgrow="ALWAYS">
                                            <Label text="TOTAL WINS" styleClass="won-stat-label"/>
                                            <Label fx:id="totalWinsLabel" text="0" styleClass="won-stat-value"/>
                                        </VBox>

                                        <VBox spacing="6.0" styleClass="won-stat-card won-stat-card-strong" HBox.hgrow="ALWAYS">
                                            <Label text="TOTAL SPENT" styleClass="won-stat-label"/>
                                            <Label fx:id="totalSpentLabel" text="USD 0" styleClass="won-stat-value"/>
                                        </VBox>

                                        <VBox spacing="6.0" styleClass="won-stat-card" HBox.hgrow="ALWAYS">
                                            <Label text="LATEST WIN" styleClass="won-stat-label"/>
                                            <Label fx:id="latestWinLabel" text="No win yet" styleClass="won-stat-value won-stat-value-small" wrapText="true"/>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="14.0" styleClass="won-section-card">
                                        <Label text="Winner Notifications" styleClass="won-section-title"/>
                                        <VBox fx:id="notificationsBox" spacing="10.0"/>
                                    </VBox>

                                    <VBox spacing="14.0" styleClass="won-section-card">
                                        <Label text="Successful Auctions" styleClass="won-section-title"/>
                                        <Label fx:id="wonMessageLabel"
                                               managed="false"
                                               styleClass="won-message-label"
                                               text=""
                                               visible="false"
                                               wrapText="true"/>
                                        <TilePane fx:id="wonAuctionGrid"
                                                  hgap="16.0"
                                                  vgap="16.0"
                                                  prefColumns="3"
                                                  prefTileWidth="320.0"/>
                                    </VBox>
                                </VBox>
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="820" prefWidth="1280" styleClass="admin-root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.auction.client.controller.AdminDashboardController">

    <center>
        <ScrollPane fx:id="adminScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="admin-scroll-pane">
            <content>
                <VBox fx:id="adminPageBox" spacing="22.0" styleClass="admin-page">
                    <padding>
                        <Insets bottom="42" left="42" right="42" top="34" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="18.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="admin-title" text="Admin Command Center" />
                            <Label styleClass="admin-subtitle" text="Platform management, moderation, and analytics" />
                        </VBox>
                        <Button onAction="#handleLogout" minWidth="112.0" prefHeight="46.0" styleClass="admin-logout-button" text="Logout" />
                    </HBox>

                    <HBox spacing="14.0">
                        <VBox spacing="8.0" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="admin-stat-label" text="TOTAL USERS" />
                            <Label fx:id="totalUsersLabel" styleClass="admin-stat-number" text="0" />
                        </VBox>

                        <VBox spacing="8.0" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="admin-stat-label" text="ACTIVE SELLERS" />
                            <Label fx:id="activeSellersLabel" styleClass="admin-stat-number" text="0" />
                        </VBox>

                        <VBox spacing="8.0" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="admin-stat-label" text="TOTAL AUCTIONS" />
                            <Label fx:id="totalAuctionsLabel" styleClass="admin-stat-number" text="0" />
                        </VBox>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <styleClass>
                                <String fx:value="admin-stat-card" />
                                <String fx:value="admin-stat-card-primary" />
                            </styleClass>
                            <Label styleClass="admin-stat-label-primary" text="PLATFORM REVENUE" />
                            <Label fx:id="revenueLabel" styleClass="admin-stat-number-primary" text="USD 0" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20.0" styleClass="admin-tabs">
                        <Button fx:id="overviewTabButton" onAction="#handleShowOverview" styleClass="admin-tab-button" text="Overview" />
                        <Button fx:id="auctionManagementTabButton" onAction="#handleShowAuctionManagement" styleClass="admin-tab-button" text="Auction Management" />
                    </HBox>

                    <VBox fx:id="overviewPane" spacing="22.0">
                        <VBox spacing="18.0" styleClass="admin-panel">
                            <padding>
                                <Insets bottom="22" left="22" right="22" top="22" />
                            </padding>

                            <Label styleClass="admin-section-title" text="Platform Overview" />
                            <GridPane hgap="16.0" vgap="16.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50.0" />
                                    <ColumnConstraints percentWidth="50.0" />
                                </columnConstraints>

                                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <styleClass>
                                        <String fx:value="admin-overview-tile" />
                                        <String fx:value="admin-overview-tile-success" />
                                    </styleClass>
                                    <Label styleClass="admin-overview-label" text="Active Auctions" />
                                    <Label fx:id="activeAuctionsLabel" styleClass="admin-overview-number" text="0" />
                                    <Label styleClass="admin-overview-caption" text="Currently live" />
                                </VBox>

                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <styleClass>
                                        <String fx:value="admin-overview-tile" />
                                        <String fx:value="admin-overview-tile-info" />
                                    </styleClass>
                                    <Label styleClass="admin-overview-label" text="Closed Auctions" />
                                    <Label fx:id="closedAuctionsLabel" styleClass="admin-overview-number" text="0" />
                                    <Label styleClass="admin-overview-caption" text="Completed auctions" />
                                </VBox>

                                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <styleClass>
                                        <String fx:value="admin-overview-tile" />
                                        <String fx:value="admin-overview-tile-info" />
                                    </styleClass>
                                    <Label styleClass="admin-overview-label" text="New Sellers" />
                                    <Label fx:id="newSellersLabel" styleClass="admin-overview-number" text="0" />
                                    <Label styleClass="admin-overview-caption" text="This month" />
                                </VBox>

                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <styleClass>
                                        <String fx:value="admin-overview-tile" />
                                        <String fx:value="admin-overview-tile-success" />
                                    </styleClass>
                                    <Label styleClass="admin-overview-label" text="Auction Success Rate" />
                                    <Label fx:id="successRateLabel" styleClass="admin-overview-number" text="0%" />
                                    <Label styleClass="admin-overview-caption" text="Backend calculated" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox spacing="14.0" styleClass="admin-panel">
                            <padding>
                                <Insets bottom="22" left="22" right="22" top="22" />
                            </padding>
                            <Label styleClass="admin-section-title" text="Recent Notifications" />
                            <Label styleClass="admin-muted" text="Latest deposits, withdrawals, and wallet activity." />
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="470.0" styleClass="admin-table-scroll" vbarPolicy="AS_NEEDED">
                                <content>
                                    <VBox fx:id="walletActivityFeedBox" spacing="12.0" />
                                </content>
                            </ScrollPane>
                        </VBox>
                    </VBox>

                    <VBox fx:id="auctionManagementPane" managed="false" spacing="18.0" visible="false">
                        <VBox spacing="16.0" styleClass="admin-panel">
                            <padding>
                                <Insets bottom="22" left="22" right="22" top="22" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="admin-section-title" text="Auction Management" />
                                    <Label styleClass="admin-muted" text="Track active, scheduled, and closed auctions across the platform." />
                                </VBox>
                                <Button onAction="#handleShowAuctionManagement" styleClass="admin-outline-button" text="Refresh" />
                            </HBox>

                            <HBox spacing="18.0" styleClass="admin-management-header">
                                <Label maxWidth="1.7976931348623157E308" styleClass="admin-management-heading" text="Auction Title" HBox.hgrow="ALWAYS" />
                                <Label minWidth="170.0" styleClass="admin-management-heading" text="Seller" />
                                <Label minWidth="120.0" styleClass="admin-management-heading" text="Status" />
                                <Label minWidth="140.0" styleClass="admin-management-heading" text="Current Bid" />
                                <Label minWidth="110.0" styleClass="admin-management-heading" text="Actions" />
                            </HBox>
                            <VBox fx:id="reviewActionPanel" managed="false" spacing="14.0" styleClass="admin-pending-card" visible="false">
                                <padding>
                                    <Insets bottom="18" left="18" right="18" top="18" />
                                </padding>
                                <Label styleClass="admin-section-title" text="Review Actions" />
                                <Label fx:id="reviewTitleLabel" styleClass="admin-pending-title" text="No item selected" />
                                <Label fx:id="reviewMetaLabel" styleClass="admin-pending-meta" text="Choose an auction or pending submission to review." wrapText="true" />
                                <HBox spacing="10.0">
                                    <Button fx:id="reviewDeleteButton" onAction="#handleReviewDelete" styleClass="admin-danger-button" text="DELETE" />
                                    <Button fx:id="reviewAcceptButton" onAction="#handleReviewAccept" styleClass="admin-primary-button" text="ACCEPT" />
                                    <Button fx:id="reviewRejectButton" onAction="#handleReviewReject" styleClass="admin-outline-button" text="REJECT" />
                                    <Button fx:id="reviewViewButton" onAction="#handleReviewView" styleClass="admin-outline-button" text="VIEW" />
                                </HBox>
                            </VBox>

                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="470.0" styleClass="admin-table-scroll" vbarPolicy="AS_NEEDED">
                                <content>
                                    <VBox fx:id="auctionRowsBox" spacing="0.0" />
                                </content>
                            </ScrollPane>
                        </VBox>

                        <Label fx:id="adminMessageLabel" maxWidth="1.7976931348623157E308" styleClass="admin-message" text="" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
